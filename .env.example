# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — Project Settings → API → service_role (SECRET)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
EMAIL_API_KEY=your-resend-api-key
EMAIL_SENDER="Bahari Asili Safaris <onboarding@resend.dev>"
EMAIL_TO=sheddymae02@gmail.com

# Deployed domain
NEXT_PUBLIC_SITE_URL=https://bahari-asili-safaris.vercel.app

# Admin dashboard
ADMIN_USERNAME=Admin
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Optional AI-powered Safari Assistant
# Add these in Vercel Project Settings → Environment Variables.
# NEVER use NEXT_PUBLIC_ for the API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
